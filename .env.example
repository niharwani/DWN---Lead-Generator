# =============================================================================
# DWN Lead Engine — Next.js runtime variables
# =============================================================================
# This file is for variables consumed by Next.js tooling itself (build-time
# config, framework behavior). It is NOT where secrets live — those go in
# `.dev.vars` (local) or Wrangler secrets (production). See `.dev.vars.example`.
#
# Copy this file to `.env.local` and adjust as needed. `.env.local` is gitignored.
# =============================================================================

# Local-only auth bypass. When NODE_ENV !== 'production', the auth helper will
# synthesize an authenticated session as this email so you can work without
# Cloudflare Access during local dev. Ignored in production.
DEV_OWNER_EMAIL=owner@dwn.local

# Marks the app as running in demo mode when D1 is empty / unavailable.
# Phase 1 uses this as the primary data switch; Phase 2 moves it onto a seeded
# owner record in D1.
NEXT_PUBLIC_DEMO_MODE=true
