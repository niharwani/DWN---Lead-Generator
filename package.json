{
  "name": "dwn-lead-engine",
  "version": "0.1.0",
  "private": true,
  "description": "DWN Lead Engine — internal lead-generation CRM for Design with Nihar",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply dwn_lead_engine --local",
    "db:migrate:remote": "wrangler d1 migrations apply dwn_lead_engine --remote",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.1",
    "drizzle-orm": "^0.38.3",
    "jose": "^5.9.6",
    "node-html-parser": "^6.1.13"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@opennextjs/cloudflare": "^1.0.0",
    "wrangler": "^3.99.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.1",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.4",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
