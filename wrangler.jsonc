/**
 * DWN Lead Engine — Cloudflare Workers configuration.
 *
 * - Deploys the Next.js app via @opennextjs/cloudflare (entry: `.open-next/worker.js`).
 * - `nodejs_compat` enables Node built-ins the Next runtime relies on.
 * - `global_fetch_strictly_public` is defense-in-depth for SSRF: the runtime
 *   itself refuses to resolve fetch() to private/loopback IPs. Application-layer
 *   SSRF checks still run in src/lib/audit/ssrf.ts.
 *
 * Replace the placeholder database_id after creating the D1 database:
 *   pnpm wrangler d1 create dwn_lead_engine
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dwn-lead-engine",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dwn_lead_engine",
      "database_id": "388e2030-6266-4286-b6e3-f03353d2904c",
      "migrations_dir": "migrations"
    }
  ],
  // Cron Triggers call protected HTTP endpoints inside this Worker.
  // The endpoints verify the X-DWN-Cron-Secret header against the CRON_SECRET
  // Worker secret before running. Set with:
  //   npx wrangler secret put CRON_SECRET
  "triggers": {
    "crons": [
      // Daily 09:00 UTC — stale-lead digest (overdue tasks, dormant qualified, stuck contacted)
      "0 9 * * *",
      // 1st of month 02:00 UTC — re-audit weak/outdated/acceptable sites, detect regressions
      "0 2 1 * *",
      // Phase D — every 15min: reply triage sweep (AI classifier)
      "*/15 * * * *",
      // Phase D — every 2h: follow-up cadence runner
      "0 */2 * * *",
      // Phase D — every 6h: bounce/DSN detection
      "0 */6 * * *",
      // Phase D — Monday 10:00 UTC: weekly digests
      "0 10 * * MON",
      // Phase D — daily 03:00 UTC: auto-enrichment pass
      "0 3 * * *",
      // Phase D — every 5min: webhook retry queue drain
      "*/5 * * * *",
      // Phase D — daily 02:15 UTC: snooze/wake sweep
      "15 2 * * *"
    ]
  }
  // Future bindings (uncomment when the phase that uses them lands):
  // "r2_buckets": [{ "binding": "LEAD_FILES", "bucket_name": "dwn-lead-files" }],
  // "queues": {
  //   "producers": [
  //     { "binding": "AUDIT_QUEUE", "queue": "dwn-audit-queue" },
  //     { "binding": "DISCOVERY_QUEUE", "queue": "dwn-discovery-queue" }
  //   ]
  // },
  // "kv_namespaces": [{ "binding": "APP_CACHE", "id": "..." }]
}
